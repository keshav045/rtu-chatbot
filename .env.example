# ==========================================
# RTU AI Academic Assistant - Environment Configuration
# ==========================================

# 1. LangSmith Observability & Tracing Configuration
# Get your free API key at: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=rtu-ai-academic-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 2. Cloud LLM API Keys (Optional - only needed if not using local Ollama)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# 3. Default Provider
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_MODEL=rtu-senior
